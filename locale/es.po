#: data/decor.json
msgid "A carved wooden archway from the original 1911 building."
msgstr "Un arco de madera tallada del edificio original de 1911."

#: data/decor.json
msgid "A date palm in a scarab-carved pot."
msgstr "Una palmera datilera en una maceta tallada con escarabajos."

