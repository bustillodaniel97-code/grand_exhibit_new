#: data/decor.json
msgid "A carved wooden archway from the original 1911 building."
msgstr "Un arco in legno intagliato dall'edificio originale del 1911."

#: data/decor.json
msgid "A date palm in a scarab-carved pot."
msgstr "Una palma da datteri in un vaso intagliato a scarabei."

#: data/decor.json
msgid "A fir dusted in real snow, somehow."
msgstr "Un abete spolverato di neve vera, chissà come."

#: data/decor.json
msgid "A gleaming centerpiece. Coins tossed in are pure profit."
msgstr "Un centrotavola scintillante. Le monete lanciate sono guadagno puro."

#: data/decor.json
msgid "A hedge trimmed into the shape of the original hall."
msgstr "Una siepe potata a forma della sala originale."

#: data/decor.json
msgid "A living arch of coral in a shallow pool."
msgstr "Un arco vivo di corallo in una vasca poco profonda."

#: data/decor.json
msgid "A painted amphora from the river delta."
msgstr "Un'anfora dipinta del delta del fiume."

#: data/decor.json
msgid "A pearly nautilus older than the palace."
msgstr "Un nautilo perlaceo più antico del palazzo."

#: data/decor.json
msgid "A pine cone the size of a toddler. Visitors pose with it."
msgstr "Una pigna grande come un bambino. I visitatori ci posano accanto."

#: data/decor.json
msgid "A poet in marble, laurel slightly askew."
msgstr "Un poeta di marmo, con l'alloro un po' storto."

#: data/decor.json
