#: data/decor.json
msgid "A carved wooden archway from the original 1911 building."
msgstr "Um arco de madeira entalhada do prédio original de 1911."

#: data/decor.json
msgid "A date palm in a scarab-carved pot."
msgstr "Uma tamareira num vaso entalhado com escaravelhos."

