{
  "_doc": [
    "Dig Site: the excavation mini game. Each museum has its own site whose",
    "artifacts fit its collection. Read by scripts/digsite/dig_system.gd.",
    "",
    "  grid        cols x rows cells, each covered by `layers` of soil.",
    "  tools       pick clears 2 layers (fast) but cracks an artifact it breaks",
    "              through onto; brush clears 1 layer and is always safe. Rock",
    "              cells take pick hits only.",
    "  energy      every swing costs 1. Regenerates over time; ads and gems refill.",
    "  artifacts   `cells` is the footprint on the grid (the model is built to",
    "              fit it), `shape` the art3d/artifacts model, `colors` its main",
    "              and accent paint. A recovered artifact joins that museum's",
    "              collection: income_bonus x quality (1-3 stars / 3).",
    "  set_bonus   extra museum income once all five are in the collection."
  ],
  "grid": {"cols": 7, "rows": 9, "layers": 3},
  "tools": {"pick": {"depth": 2, "cost": 1}, "brush": {"depth": 1, "cost": 1}},
  "energy": {"max": 30, "regen_seconds": 150, "ad_refill": 15, "gem_refill_cost": 20, "start": 30},
  "finds": {"coins": 4, "gems": 1, "crystals": 1, "rocks": 5, "survey_flags": 2,
    "coin_income_seconds": 30, "gem_amount": [1, 3], "crystal_energy": 3},
  "rewards": {"income_bonus": 0.04, "set_bonus": 0.15, "gems_by_rarity": {"common": 5, "rare": 10, "epic": 20}},
