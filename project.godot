; Engine configuration file.
; Grand Exhibit — idle museum tycoon. Godot 4.4, portrait mobile.
; Editing rules for agents: DO NOT edit this file. Autoloads are pre-registered.

config_version=5

[application]

config/name="Grand Exhibit"
config/description="Idle museum tycoon - build, staff, and prestige your museum empire."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.2, 0.18, 0.16, 1)

[autoload]

EventBus="*res://autoload/event_bus.gd"
DataLoader="*res://autoload/data_loader.gd"
ClockGuard="*res://autoload/clock_guard.gd"
Analytics="*res://autoload/analytics.gd"
AdService="*res://autoload/ad_service.gd"
IAPService="*res://autoload/iap_service.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
Economy="*res://autoload/economy.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[debug]

gdscript/warnings/untyped_declaration=1
